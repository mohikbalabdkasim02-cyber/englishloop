:root {
  --bg: #f7f7f4;
  --paper: #ffffff;
  --ink: #17201f;
  --muted: #6f7774;
  --line: #e6e8e3;
  --primary: #6557e8;
  --primary-dark: #4b40c7;
  --primary-soft: #eeeafd;
  --lime: #dff56b;
  --mint: #d9f3e7;
  --sky: #ddeefa;
  --peach: #ffe1d2;
  --danger: #d85d5d;
  --shadow: 0 20px 60px rgba(24, 35, 32, 0.08);
  --radius-lg: 28px;
  --radius-md: 20px;
  --radius-sm: 14px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: var(--bg); font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
a { color: inherit; }

.brand { display: flex; align-items: center; gap: 11px; min-width: 0; }
.brand > div:last-child { display: grid; }
.brand strong { font-size: 17px; letter-spacing: -0.025em; }
.brand small { color: var(--muted); margin-top: 1px; font-size: 11px; }
.brand-mark { position: relative; width: 34px; height: 34px; border-radius: 12px; background: var(--ink); flex: 0 0 auto; overflow: hidden; }
.brand-mark span { position: absolute; border: 2px solid var(--lime); border-radius: 999px; width: 17px; height: 17px; }
.brand-mark span:first-child { left: 5px; top: 8px; }
.brand-mark span:last-child { right: 5px; top: 8px; transform: rotate(180deg); }
.brand-compact small { display: none; }

.btn { border: 0; border-radius: 12px; min-height: 42px; padding: 0 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; font-size: 14px; transition: .18s ease; }
.btn:hover { transform: translateY(-1px); }
.btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }
.btn-primary { background: var(--primary); color: white; box-shadow: 0 8px 24px rgba(101, 87, 232, .18); }
.btn-primary:hover { background: var(--primary-dark); }
.btn-dark { background: var(--ink); color: white; }
.btn-soft { background: #f0f1ed; color: var(--ink); }
.btn-light { background: white; color: var(--ink); }
.btn-ghost { background: transparent; color: var(--ink); }
.btn-lg { min-height: 50px; padding: 0 20px; border-radius: 14px; }
.full { width: 100%; }
.icon-btn { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 12px; background: white; display: inline-flex; align-items: center; justify-content: center; color: var(--ink); }
.icon-btn.danger { color: var(--danger); }
.text-btn { border: 0; background: transparent; color: var(--primary); font-weight: 800; display: inline-flex; align-items: center; gap: 5px; }
.eyebrow { display: inline-flex; align-items: center; gap: 7px; color: var(--primary); font-size: 11px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
.spin { animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Landing */
.landing-shell { min-height: 100vh; overflow: hidden; background: #fafaf7; }
.landing-nav { height: 82px; display: flex; align-items: center; justify-content: space-between; max-width: 1240px; padding: 0 26px; margin: auto; }
.landing-nav-actions { display: flex; gap: 8px; }
.hero { max-width: 1240px; margin: auto; min-height: 710px; padding: 62px 26px 70px; display: grid; grid-template-columns: 1.05fr .95fr; gap: 70px; align-items: center; }
.hero-copy h1 { font-size: clamp(50px, 6vw, 82px); line-height: .98; letter-spacing: -.065em; margin: 22px 0 26px; max-width: 760px; }
.hero-copy h1 span { color: var(--primary); }
.hero-copy > p { color: #5f6864; font-size: 19px; line-height: 1.7; max-width: 640px; }
.hero-actions { display: flex; gap: 10px; margin: 34px 0 40px; }
.hero-proof { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.hero-proof div { display: flex; align-items: center; gap: 7px; }
.hero-proof strong { font-size: 10px; border: 1px solid var(--line); border-radius: 999px; padding: 5px 7px; color: var(--primary); }
.hero-proof span { font-size: 12px; font-weight: 800; color: var(--muted); }
.hero-proof i { width: 18px; height: 1px; background: #cfd3ce; }
.hero-visual { min-height: 610px; position: relative; display: flex; align-items: center; justify-content: center; }
.preview-glow { width: 520px; height: 520px; background: radial-gradient(circle, rgba(101,87,232,.18), rgba(223,245,107,.12) 50%, transparent 72%); position: absolute; border-radius: 50%; }
.phone-frame { width: 330px; border: 9px solid #18201f; border-radius: 38px; background: white; box-shadow: 0 45px 90px rgba(30, 38, 35, .18); position: relative; z-index: 2; transform: rotate(2.5deg); overflow: hidden; }
.phone-top { height: 31px; background: #18201f; color: #fff; font-size: 9px; display: flex; justify-content: space-between; padding: 8px 17px; }
.phone-content { background: #f7f7f4; padding: 20px 16px 18px; min-height: 530px; }
.mini-greeting { display: grid; gap: 4px; margin-bottom: 15px; }
.mini-greeting span { color: var(--muted); font-size: 10px; }
.mini-greeting strong { font-size: 18px; letter-spacing: -.03em; }
.mini-hero-card { border-radius: 24px; background: var(--primary); color: white; padding: 19px; overflow: hidden; position: relative; }
.mini-hero-card:after { content: ""; width: 120px; height: 120px; border: 24px solid rgba(223,245,107,.18); border-radius: 50%; position: absolute; right: -46px; top: -42px; }
.mini-chip { font-size: 8px; text-transform: uppercase; letter-spacing: .1em; font-weight: 900; opacity: .82; }
.mini-hero-card h3 { position: relative; z-index: 1; font-size: 19px; line-height: 1.25; max-width: 220px; letter-spacing: -.03em; margin: 14px 0; }
.mini-wave { height: 35px; display: flex; align-items: center; gap: 4px; }
.mini-wave span { width: 3px; border-radius: 99px; background: var(--lime); height: 14px; }
.mini-wave span:nth-child(2), .mini-wave span:nth-child(6) { height: 25px; }
.mini-wave span:nth-child(3), .mini-wave span:nth-child(5) { height: 32px; }
.mini-wave span:nth-child(4) { height: 20px; }
.mini-hero-card button { background: white; color: var(--ink); border: 0; padding: 9px 12px; font-size: 10px; font-weight: 800; border-radius: 9px; display: flex; gap: 6px; align-items: center; margin-top: 4px; }
.mini-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin: 11px 0; }
.mini-stats div { border: 1px solid var(--line); background: white; border-radius: 16px; padding: 12px; display: grid; gap: 4px; }
.mini-stats svg { color: var(--primary); }
.mini-stats strong { font-size: 16px; }
.mini-stats span { font-size: 9px; color: var(--muted); }
.mini-next { display: grid; grid-template-columns: 39px 1fr auto; align-items: center; gap: 9px; border: 1px solid var(--line); background: white; border-radius: 16px; padding: 11px; }
.mini-next-icon { width: 39px; height: 39px; background: var(--mint); display: grid; place-items: center; border-radius: 12px; }
.mini-next div:nth-child(2) { display: grid; gap: 2px; }
.mini-next small { font-size: 7px; color: var(--muted); letter-spacing: .1em; }
.mini-next strong { font-size: 11px; }
.mini-next span { font-size: 8px; color: var(--muted); }
.floating-card { position: absolute; background: rgba(255,255,255,.94); border: 1px solid rgba(229,231,226,.9); border-radius: 17px; padding: 12px 15px; box-shadow: var(--shadow); display: flex; align-items: center; gap: 10px; z-index: 3; max-width: 225px; backdrop-filter: blur(10px); }
.floating-card svg { color: var(--primary); flex: 0 0 auto; }
.floating-card div { display: grid; gap: 2px; }
.floating-card strong { font-size: 12px; }
.floating-card span { font-size: 9px; color: var(--muted); line-height: 1.4; }
.floating-card-one { left: -8px; top: 165px; }
.floating-card-two { right: -4px; bottom: 116px; }
.loop-section { background: #181f1e; color: white; padding: 100px max(26px, calc((100vw - 1188px)/2)); }
.section-kicker { font-size: 10px; font-weight: 900; letter-spacing: .16em; color: var(--lime); }
.loop-section h2 { font-size: clamp(34px, 4vw, 55px); letter-spacing: -.045em; line-height: 1.06; max-width: 900px; margin: 18px 0 55px; }
.loop-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 13px; }
.loop-card { min-height: 245px; padding: 22px; border: 1px solid #343b39; border-radius: 22px; background: #202827; display: flex; flex-direction: column; align-items: flex-start; }
.loop-card > span { color: #78807d; font-size: 10px; font-weight: 900; }
.loop-card svg { color: var(--lime); margin-top: auto; margin-bottom: 14px; }
.loop-card h3 { margin: 0 0 8px; font-size: 18px; }
.loop-card p { color: #aeb5b2; font-size: 13px; line-height: 1.55; margin: 0; }
.portfolio-strip { max-width: 1188px; margin: 0 auto; padding: 95px 26px; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
.portfolio-strip > div:first-child { display: grid; gap: 7px; }
.portfolio-strip small { color: var(--muted); font-size: 9px; letter-spacing: .14em; }
.portfolio-strip strong { font-size: 26px; letter-spacing: -.03em; }
.portfolio-strip span { color: var(--muted); font-size: 14px; }
.portfolio-quote { font-size: clamp(28px,4vw,47px); font-weight: 900; line-height: 1.02; letter-spacing: -.05em; text-align: right; color: var(--primary); }
.landing-footer { border-top: 1px solid var(--line); min-height: 95px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; max-width: 1188px; margin: auto; gap: 30px; color: var(--muted); font-size: 11px; }
.landing-footer > span:last-child { text-align: right; }

/* modal/forms */
.modal-backdrop { position: fixed; inset: 0; background: rgba(14, 20, 19, .58); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(8px); }
.login-modal { width: min(460px,100%); background: white; border-radius: 28px; padding: 28px; position: relative; box-shadow: 0 35px 100px rgba(0,0,0,.18); }
.modal-close { position: absolute; right: 20px; top: 20px; }
.login-copy { margin: 35px 0 24px; }
.login-copy h2 { margin: 0 0 8px; font-size: 30px; letter-spacing: -.045em; }
.login-copy p { color: var(--muted); margin: 0; line-height: 1.5; }
.stack-form { display: grid; gap: 14px; }
.stack-form label, .builder-form label { display: grid; gap: 7px; }
.stack-form label span, .builder-form label > span { font-size: 11px; font-weight: 800; color: #4e5754; }
.stack-form input, .builder-form input, .builder-form select, .builder-form textarea { width: 100%; border: 1px solid var(--line); border-radius: 12px; padding: 12px 13px; background: #fbfbf9; outline: none; color: var(--ink); }
.stack-form input:focus, .builder-form input:focus, .builder-form select:focus, .builder-form textarea:focus { border-color: #a59cf3; box-shadow: 0 0 0 3px rgba(101,87,232,.08); }
.form-error { color: #ad3e3e; background: #fff0ef; border-radius: 12px; padding: 11px 12px; font-size: 12px; }
.demo-hint { margin-top: 17px; display: flex; gap: 8px; color: var(--muted); background: #f5f5f1; padding: 12px; border-radius: 12px; font-size: 11px; line-height: 1.45; }

/* Student shell */
.student-app { min-height: 100vh; padding-bottom: 92px; }
.student-header { height: 76px; background: rgba(247,247,244,.88); backdrop-filter: blur(18px); border-bottom: 1px solid rgba(230,232,227,.75); position: sticky; top: 0; z-index: 20; padding: 0 max(22px, calc((100vw - 1120px)/2)); display: flex; align-items: center; justify-content: space-between; }
.student-header-right { display: flex; align-items: center; gap: 10px; }
.demo-badge { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; background: var(--primary-soft); color: var(--primary); padding: 7px 9px; border-radius: 999px; font-weight: 900; }
.avatar-btn { border: 0; width: 36px; height: 36px; border-radius: 12px; background: var(--ink); color: white; font-weight: 900; }
.student-main { max-width: 1120px; margin: auto; }
.student-page { padding: 48px 22px 30px; }
.page-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
